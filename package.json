{
  "name": "dsh-codex-migrate-next",
  "version": "2.0.5",
  "description": "One-way structured conversation, project, MCP, memory, and context migration between Codex and DeepSeek Harness. Codex 与 DSH 的单向结构化迁移插件。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codex",
    "migration",
    "conversation-import",
    "mcp",
    "plugin",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jichengkai/dsh-codex-migrate.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "codex/",
    "images/banner.webp",
    "images/continue-in-codex-action.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-0 <0.3.0-0",
    "react": "^18.2.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test test/*.test.mjs",
    "test:bridge": "node scripts/test-bridge.mjs"
  },
  "homepage": "https://github.com/jichengkai/dsh-codex-migrate#readme",
  "bugs": {
    "url": "https://github.com/jichengkai/dsh-codex-migrate/issues"
  }
}
